{
  "name": "@sahamati/agent-server",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "sahamati": "./bin/sahamati.mjs"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "embed": "node scripts/embed-assets.mjs",
    "build": "npm run embed && tsc",
    "start": "node --env-file=.env dist/index.js",
    "cli": "bun src/cli.ts",
    "build:cli": "npm run embed && bun build --compile --minify --outfile dist/sahamati src/cli.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "evernote": "^2.0.5",
    "hono": "^4.7.0",
    "jose": "^5.9.0",
    "openclaw": "^2026.3.8",
    "otpauth": "^9.5.0",
    "@google/genai": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
