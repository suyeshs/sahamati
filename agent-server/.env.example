# Cloudflare deployment (Workers for Platforms) — fill these in agent-server/.env
# .env itself is gitignored; never commit real values here.
#
# Token permissions required (scoped to your account, NOT the global key):
#   Workers Scripts:Edit
#   Workers for Platforms:Edit
#   D1:Edit
#   R2:Edit
#   KV:Edit
#   Custom Hostnames:Edit
#
# The dispatch namespace must already exist in the account — create it once
# via the dashboard or wrangler before enabling deployments.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WFP_NAMESPACE=sahamati-internal
CLOUDFLARE_HOSTNAME_ZONE=

# Rank Math WordPress SEO agent — connects to the MCP server built into the
# Rank Math plugin (1.0.272+) at /wp-json/mcp/mcp-adapter-default-server.
# Use a named WordPress Application Password (Users → Profile → Application
# Passwords), never the login password.
RANKMATH_WP_URL=
RANKMATH_WP_USERNAME=
RANKMATH_WP_APP_PASSWORD=

# mail-e Gmail triage agent — read-only access (gmail.readonly scope).
# 1. Create an OAuth client (type: Desktop app) in Google Cloud Console with
#    the Gmail API enabled, on the sahamati.org.in workspace.
# 2. Run `bun run scripts/gmail-auth.ts` to consent once and print the
#    refresh token. Sign in with your @sahamati.org.in account.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Defender (dependency-CVE scanning and remediation PRs)
# Scheduler is opt-in so the desktop sidecar never runs scans on its own.
# SAHAMATI_DEFENDER_SCHEDULER=1
# Fine-grained PAT (contents: read/write, pull requests: write) used only for
# scheduled runs; manual runs use the signed-in user's GitHub connection.
# SAHAMATI_DEFENDER_GITHUB_TOKEN=
# SAHAMATI_DEFENDER_MAX_CONCURRENT=1
# SAHAMATI_DEFENDER_SCHEDULE_PHASE=scan          # or scan+triage (spends model credits)
# SAHAMATI_DEFENDER_KEEP_WORKSPACE=0             # 1 keeps per-run temp checkouts for debugging
# SAHAMATI_DEFENDER_GIT_AUTHOR="Sahamati Defender <defender-bot@users.noreply.github.com>"
# SAHAMATI_DEFENDER_CVE_WATCH_HOURS=6             # feed re-check cadence (0 disables); also runs on page load when stale
# SAHAMATI_DEFENDER_ALERT_MIN_SEVERITY=high       # critical|high|medium|low
